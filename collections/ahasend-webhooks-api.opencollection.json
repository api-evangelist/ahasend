            "method": "GET",
            "url": "https://api.ahasend.com/v2/accounts/:account_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "account_id",
                "value": "500123",
                "type": "path",
                "description": "Account ID"
              },
              {
                "name": "webhook_id",
                "value": "500123",
                "type": "path",
                "description": "Webhook ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a specific webhook by ID"
        },
        {
