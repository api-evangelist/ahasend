              {
                "name": "webhook_id",
                "value": "500123",
                "type": "path",
                "description": "Webhook ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an existing webhook\n\n**Note:** The webhook secret is not updatable\n"
        },
        {
          "info": {
            "name": "AhaSend Delete Webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ahasend.com/v2/accounts/:account_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "account_id",
                "value": "500123",
                "type": "path",
                "description": "Account ID"
              },
              {
                "name": "webhook_id",
                "value": "500123",
                "type": "path",
                "description": "Webhook ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a webhook"
        }
      ]
    }
  ],
  "bundled": true
}